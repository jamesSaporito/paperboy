{
  "name": "@paperboy/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsdown --watch --on-success \"node --env-file-if-exists=../../.env --enable-source-maps dist/main.mjs\"",
    "build": "tsdown",
    "start": "node --enable-source-maps dist/main.mjs",
    "test": "vitest run",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "mail:up": "[ -n \"$DEV_CONTAINER\" ] || docker compose up -d --wait greenmail",
    "s3:up": "[ -n \"$DEV_CONTAINER\" ] || docker compose up -d --wait s3mock",
    "contact": "tsx scripts/contact.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@paperboy/ai": "workspace:*",
    "@paperboy/contracts": "workspace:*",
    "@paperboy/db": "workspace:*",
    "file-type": "22.2.0",
    "imapflow": "2.9.1",
    "mailparser": "3.12.4",
    "nodemailer": "10.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@paperboy/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
