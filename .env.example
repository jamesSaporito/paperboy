# Copy to .env for native development (`cp .env.example .env`).
# Docker Compose reads .env too, but sets its own DATABASE_URL for containers.

# Backend
PORT=3100
DATABASE_URL=postgresql://paperboy:paperboy@localhost:5433/paperboy

# Mailbox the app reads and sends from: a dedicated Gmail account (one for development, a separate
# one for production) and its app password. Gmail's servers are the default. Tests ignore these and
# always use the local GreenMail server.
MAIL_ADDRESS=your-dev-account@gmail.com
MAIL_PASSWORD=your-app-password

# Twilio. Locally these point at the simulator (apps/twilio-sim), which uses the same
# credentials to sign webhooks and check Messages API auth. Use real values in production.
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=00000000000000000000000000000000
TWILIO_PHONE_NUMBER=+15555550100

# Twilio simulator (local only). Open http://localhost:3101 for the simulated phone.
TWILIO_SIM_PORT=3101
# The app's incoming-message webhook. Docker Compose overrides this (and TWILIO_SIM_PUBLIC_URL).
TWILIO_SIM_WEBHOOK_URL=http://localhost:3100/twilio/messages
