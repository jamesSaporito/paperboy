# Copy to .env for native development (`cp .env.example .env`).
# Docker Compose reads .env too, but sets its own DATABASE_URL for containers.

# Backend
PORT=3100
DATABASE_URL=postgresql://paperboy:paperboy@localhost:5433/paperboy

# Mailbox the app reads and sends from: a dedicated Gmail account (one for development, a separate
# one for production) and its app password. Gmail's servers are the default. Tests ignore these and
# always use the local GreenMail server.
MAIL_ADDRESS=your-dev-account@gmail.com
MAIL_PASSWORD=your-app-password

# AI: the OpenAI API, or the local llama.cpp container (docker-compose.yml, port 8081).
#   Local model: OPENAI_BASE_URL=http://localhost:8081/v1, OPENAI_TEXT_MODEL=llama, any API key.
#   OpenAI:      leave OPENAI_BASE_URL empty, and set a real OPENAI_API_KEY and model names.
# Docker Compose points the backend container at the llama container itself when this is set.
OPENAI_BASE_URL=http://localhost:8081/v1
OPENAI_API_KEY=local
OPENAI_TEXT_MODEL=llama
# OpenAI only (llama.cpp can't generate images); leave unset until images are used.
# OPENAI_IMAGE_MODEL=
# The local model file, in LLAMA_MODELS_DIR (default: the models folder next to this project).
LLAMA_MODELS_DIR=../models
LLAMA_MODEL=llama-3.2-3b-instruct-q4_k_m.gguf

# Secret for POST /jobs/front-page (Authorization: Bearer <token>), which runs the weekly front page
# on demand. At least 32 characters; generate one with `openssl rand -base64 32`.
JOBS_TOKEN=change-me-to-a-long-random-string

# S3 bucket for submission images. Locally: s3mock (Docker Compose overrides S3_ENDPOINT for the
# container), which ignores credentials but the AWS SDK requires some. In production: leave out
# S3_ENDPOINT and the keys so the SDK uses AWS and its role; the bucket comes from Terraform.
S3_BUCKET=paperboy-submissions
S3_ENDPOINT=http://localhost:9091
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
